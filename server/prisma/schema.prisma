generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String?
  avatar     String?
  role       Role     @default(USER)
  googleId   String?  @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  createdProblems Problem[]     @relation("UserCreatedProblems")
  problemProgress UserProblem[] @relation("UserProgress")
  notes     Note[]
  resumes   Resume[]
  doubtSessions   DoubtSession[]
  roadmaps        Roadmap[]
  interviewSessions InterviewSession[]
  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

model Problem {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  difficulty    Difficulty
  tags          String[]
  summary       String
  examples      Json
  constraints   String?
  hints         String[]
  estimatedTime Int?
  sourceUrl     String?
  isCurated     Boolean    @default(false)
  createdById   String?
  createdBy     User?      @relation("UserCreatedProblems", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())

  userProgress  UserProblem[]
  doubtSessions DoubtSession[] 

  @@map("problems")
  notes         Note[]
}

model UserProblem {
  id           String          @id @default(cuid())
  userId       String
  problemId    String
  status       ProgressStatus  @default(NOT_STARTED)
  starred      Boolean         @default(false)
  confidence   Confidence?
  notes        String?
  attemptCount Int             @default(0)
  lastSolved   DateTime?
  nextRevision DateTime?
  updatedAt    DateTime        @updatedAt

  user         User            @relation("UserProgress", fields: [userId], references: [id])
  problem      Problem         @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
  @@map("user_problems")
}


model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  category  String?
  problemId String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notes")
}

model Resume {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  fileUrl        String
  fileName       String
  extractedText  String   @db.Text
  targetJD       String?  @db.Text
  atsScore       Int
  scoreBreakdown Json
  missingSkills  String[]
  suggestions    Json
  createdAt      DateTime @default(now())

  @@index([userId])
}

model DoubtSession {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  title         String?       // auto-generated from first message, or "Doubt on: <problem title>"
  problemId     String?       // nullable — set only when opened from a Coding Practice problem
  problem       Problem?      @relation(fields: [problemId], references: [id])
  messages      DoubtMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
}

model DoubtMessage {
  id          String        @id @default(uuid())
  sessionId   String
  session     DoubtSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String        // "user" | "model"
  content     String        @db.Text
  imageUrl    String?
  createdAt   DateTime      @default(now())

  @@index([sessionId])
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Roadmap {
  id              String     @id @default(uuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- snapshot of the inputs used to generate this roadmap ---
  // Stored (not just used transiently) so that if the user looks at an old
  // roadmap in their history, they can see WHAT they asked for, and so we
  // can support "regenerate with same inputs" later without re-asking.
  targetRole      String
  skillLevel      SkillLevel
  timelineWeeks   Int              // total weeks this roadmap spans, e.g. 12
  targetCompanies String[]         // empty array if user left it blank
  weakTopics      String[]         // the tags they confirmed before generating (from Coding Practice/Resume, editable)

  // --- which roadmap is currently "checked out" ---
  // Only one Roadmap per user should have isActive = true at a time.
  // Enforced in application code (Prisma can't do "unique where true" easily
  // across Postgres without a partial index migration) — the roadmap
  // controller will handle flipping the old active one to false.
  isActive        Boolean    @default(true)

  weeks           RoadmapWeek[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@map("roadmaps")
}

model RoadmapWeek {
  id          String        @id @default(uuid())
  roadmapId   String
  roadmap     Roadmap       @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  weekNumber  Int           // 1-indexed, used for ordering and the "Week 1" label
  theme       String        // short label for the graph node, e.g. "Arrays & Strings"
  description String?       @db.Text  // longer blurb shown when the week is expanded

  days        RoadmapDay[]

  // A roadmap can't have two "Week 3"s — guards against a buggy Gemini
  // response accidentally creating duplicate week numbers.
  @@unique([roadmapId, weekNumber])
  @@index([roadmapId])
  @@map("roadmap_weeks")
}

model RoadmapDay {
  id         String        @id @default(uuid())
  weekId     String
  week       RoadmapWeek   @relation(fields: [weekId], references: [id], onDelete: Cascade)

  dayNumber  Int           // 1-7 within that week
  focus      String        // e.g. "Two Pointers Pattern" — shown as the day's title in the accordion

  tasks      RoadmapTask[]

  @@unique([weekId, dayNumber])
  @@index([weekId])
  @@map("roadmap_days")
}

model RoadmapTask {
  id          String     @id @default(uuid())
  dayId       String
  day         RoadmapDay @relation(fields: [dayId], references: [id], onDelete: Cascade)

  content     String     @db.Text   // e.g. "Solve 3 two-pointer problems from Coding Practice"
  resourceUrl String?               // optional external link (article, LeetCode tag, video)

  // The actual tracker state. completedAt (not just a boolean) lets us later
  // build a streak/activity view on the Profile page for free, without a
  // schema change — same reasoning as UserProblem.lastSolved.
  isCompleted Boolean    @default(false)
  completedAt DateTime?

  @@index([dayId])
  @@map("roadmap_tasks")
}



// Interview Simulator  

enum InterviewPersona {
  FRIENDLY        // Ava — patient, offers hints, "take your time"
  FAANG           // Noah — terse, minimal reactions, sharper follow-ups
  HIRING_MANAGER  // Claire — behavioral-heavy, probes leadership/communication
}

enum DurationPreset {
  QUICK     // ~15 min, 4 main questions
  STANDARD  // ~30 min, 7 main questions
  EXTENDED  // ~45 min, 10 main questions
}

enum SessionSectionType {
  INTRO
  RESUME
  BEHAVIORAL
  TECHNICAL
  CODING
  CLOSING
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED   // user closed the tab mid-session — lets us distinguish this from a real completed report
}

enum InputMode {
  VOICE
  TEXT   // used for CODING-section turns, where dictating code isn't practical
}

enum TurnDecision {
  FOLLOW_UP     // Gemini wants to dig deeper on the same question thread
  NEXT_SECTION  // move on to the next question/section
  COMPLETE      // this was the final turn — session is ready for final aggregation
}

model InterviewSession {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- snapshot of session setup, same philosophy as Roadmap's stored inputs ---
  targetRole     String
  skillLevel     SkillLevel        // reusing the enum from Roadmap — same meaning, no need to duplicate it
  persona        InterviewPersona
  durationPreset DurationPreset
  questionBudget Int               // resolved main-question count for the chosen preset, e.g. 7

  // Fresh resume upload for THIS session only — deliberately not a relation
  // to the Day 12 Resume model. See explanation above.
  resumeFileName String?
  resumeText     String? @db.Text

  // Ordered section plan decided once at session start, e.g.
  // [{"type":"INTRO","count":1},{"type":"TECHNICAL","count":4}, ...]
  sectionPlan Json

  status SessionStatus @default(IN_PROGRESS)

  // --- final aggregate scores + narrative feedback ---
  // Null while IN_PROGRESS, filled in by the final Gemini call once the
  // session completes.
  overallScore        Float?
  communicationScore  Float?
  codingScore         Float?
  confidenceScore     Float?
  problemSolvingScore Float?
  behavioralScore     Float?
  overallFeedback     String?  @db.Text
  strengths           String[]
  improvementAreas    String[]

  turns InterviewTurn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("interview_sessions")
}

model InterviewTurn {
  id        String           @id @default(uuid())
  sessionId String
  session   InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sectionType SessionSectionType
  order       Int                 // absolute position in the session, drives replay/history ordering

  questionText String    @db.Text
  inputMode    InputMode

  isFollowUp   Boolean         @default(false)
  parentTurnId String?
  parentTurn   InterviewTurn?  @relation("TurnFollowUps", fields: [parentTurnId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  followUps    InterviewTurn[] @relation("TurnFollowUps")

  transcript String? @db.Text  // null until the user actually answers

  // --- speech-pattern metrics, computed by US from SpeechRecognition timing
  // data, not by Gemini. Null for TEXT-mode (CODING) turns — no voice to
  // measure there. These feed confidenceScore alongside Gemini's linguistic
  // read of hedging language in the transcript. See interviewAi.ts (next file).
  hesitationMs    Int?
  durationMs      Int?
  wordCount       Int?
  wpm             Float?
  fillerWordCount Int?
  longPauseCount  Int?

  // --- per-turn scoring, filled in right after the answer is submitted ---
  technicalScore     Float?
  communicationScore Float?
  confidenceScore    Float?

  // Live notes — short strings for the "quietly writes ✔/⚠" report feature.
  // Invisible during the session, surfaced only on the end report.
  positives String[]
  concerns  String[]

  // CODING turns only: syntax issues Gemini spotted but deliberately did
  // NOT factor into technicalScore (logic/approach only, per your request).
  syntaxNotes String? @db.Text

  geminiDecision TurnDecision?

  createdAt DateTime @default(now())

  @@index([sessionId])
  @@map("interview_turns")
}