// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id         String   @id @default(cuid())
  name       String
  email      String   @unique
  password   String?
  avatar     String?
  role       Role     @default(USER)
  googleId   String?  @unique
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  createdProblems Problem[]     @relation("UserCreatedProblems")
  problemProgress UserProblem[] @relation("UserProgress")
  notes     Note[]
  resumes   Resume[]
  doubtSessions   DoubtSession[]

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProgressStatus {
  NOT_STARTED
  ATTEMPTED
  SOLVED
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

model Problem {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  difficulty    Difficulty
  tags          String[]
  summary       String
  examples      Json
  constraints   String?
  hints         String[]
  estimatedTime Int?
  sourceUrl     String?
  isCurated     Boolean    @default(false)
  createdById   String?
  createdBy     User?      @relation("UserCreatedProblems", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())

  userProgress  UserProblem[]
  doubtSessions DoubtSession[] 

  @@map("problems")
  notes         Note[]
}

model UserProblem {
  id           String          @id @default(cuid())
  userId       String
  problemId    String
  status       ProgressStatus  @default(NOT_STARTED)
  starred      Boolean         @default(false)
  confidence   Confidence?
  notes        String?
  attemptCount Int             @default(0)
  lastSolved   DateTime?
  nextRevision DateTime?
  updatedAt    DateTime        @updatedAt

  user         User            @relation("UserProgress", fields: [userId], references: [id])
  problem      Problem         @relation(fields: [problemId], references: [id])

  @@unique([userId, problemId])
  @@map("user_problems")
}


model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String   @db.Text
  category  String?
  problemId String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem   Problem? @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notes")
}

model Resume {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  fileUrl        String
  fileName       String
  extractedText  String   @db.Text
  targetJD       String?  @db.Text
  atsScore       Int
  scoreBreakdown Json
  missingSkills  String[]
  suggestions    Json
  createdAt      DateTime @default(now())

  @@index([userId])
}

model DoubtSession {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  title         String?       // auto-generated from first message, or "Doubt on: <problem title>"
  problemId     String?       // nullable — set only when opened from a Coding Practice problem
  problem       Problem?      @relation(fields: [problemId], references: [id])
  messages      DoubtMessage[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
}

model DoubtMessage {
  id          String        @id @default(uuid())
  sessionId   String
  session     DoubtSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role        String        // "user" | "model"
  content     String        @db.Text
  createdAt   DateTime      @default(now())

  @@index([sessionId])
}